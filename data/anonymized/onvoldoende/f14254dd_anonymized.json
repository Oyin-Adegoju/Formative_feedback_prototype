      "heading_path": [
        "2.1 Constraints en requirements",
        "Waarom MoSCoW"
      ],
      "text": "zoals zoeken en bestelgeschiedenis zijn minder belangrijk omdat het vooral gaat om bestellen. Vormgeving is ook",
      "token_estimate": 27,
      "is_front_matter": false,
      "is_appendix": false,
      "table_meta": null
    },
    {
      "doc_id": "f14254dd",
