      "block_type": "paragraph",
      "heading_path": [
        "H1 Introductie",
        "H2 Stakeholders analyse",
        "H3 Onderzoek naar web gebruikers"
      ],
      "text": "niet gebaseerd op interviews of bronnen, maar klinkt logisch.",
      "token_estimate": 15,
      "is_front_matter": false,
      "is_appendix": false,
      "table_meta": null
    },
    {
